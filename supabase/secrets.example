# Names only. Set real values with:  supabase secrets set --env-file supabase/secrets.env
# Never commit the real file, never paste these into a chat.
BUYDIGITAL_SITE_URL=https://buydigital.my
BUYDIGITAL_ALLOWED_ORIGINS=https://buydigital.my,http://localhost:5173
BUYDIGITAL_INVENTORY_ENC_KEY=          # 32 random bytes, base64:  openssl rand -base64 32
BUYDIGITAL_INVENTORY_HASH_KEY=         # any long random string:   openssl rand -hex 32
BUYDIGITAL_TOYYIBPAY_SECRET_KEY=       # ToyyibPay dashboard > your account: userSecretKey. Keep private.
BUYDIGITAL_TOYYIBPAY_CATEGORY_CODE=    # create a Category in the dashboard, copy its code
BUYDIGITAL_TOYYIBPAY_PAYMENT_CHANNEL=0 # 0 = FPX only, 1 = cards, 2 = both (card needs approval on your account)
BUYDIGITAL_TOYYIBPAY_SANDBOX=true      # set to false for live
BUYDIGITAL_RESEND_API_KEY=
BUYDIGITAL_EMAIL_FROM=BuyDigital <support@buydigital.my>
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically on hosted Supabase.
