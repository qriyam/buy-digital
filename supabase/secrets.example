# Names only. Set real values with:  supabase secrets set --env-file supabase/secrets.env
# Never commit the real file, never paste these into a chat.
FIREBASE_PROJECT_ID=
SITE_URL=https://buydigital.my
ALLOWED_ORIGINS=https://buydigital.my,http://localhost:5173
INVENTORY_ENC_KEY=          # 32 random bytes, base64:  openssl rand -base64 32
INVENTORY_HASH_KEY=         # any long random string:   openssl rand -hex 32
TOYYIBPAY_SECRET_KEY=       # from your ToyyibPay dashboard (User Secret Key)
TOYYIBPAY_CATEGORY_CODE=    # create a Category in the dashboard, copy its code
TOYYIBPAY_PAYMENT_CHANNEL=0 # 0 = FPX only, 1 = cards, 2 = both (card needs approval on your account)
TOYYIBPAY_SANDBOX=true      # set to false for live
RESEND_API_KEY=
EMAIL_FROM=BuyDigital <support@buydigital.my>
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically on hosted Supabase.
